{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol Link Dispatcher Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "goal",
    "worker",
    "allowed_paths",
    "forbidden_paths",
    "acceptance_criteria",
    "validation_commands",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "worker": {
      "enum": [
        "luna",
        "spark"
      ]
    },
    "context": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "architectural_intent": {
      "type": "string"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "max_files": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 100
    }
  }
}
